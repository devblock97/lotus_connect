# Lotus Connect iOS Environment Example
# Copy this file to `.env.ios`:
#   cp .env.ios.example .env.ios
#
# iOS simulator runs on macOS host network stack and accesses backend via localhost:
API_BASE_URL=https://localhost:8443/api/v1

# For direct unencrypted HTTP backend without Caddy:
# API_BASE_URL=http://localhost:8080/api/v1
