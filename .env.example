# Lotus Connect Environment Configuration
# Copy the appropriate template for your target platform:
#   For iOS Simulator (localhost):      cp .env.ios.example .env.ios
#   For Android Emulator (10.0.2.2):    cp .env.android.example .env.android
#   For general development:            cp .env.example .env
#
# DO NOT commit active `.env*` files to version control!

# iOS Simulator / Desktop backend URL (Localhost):
# API_BASE_URL=https://localhost:8443/api/v1
# API_BASE_URL=http://localhost:8080/api/v1

# Android Emulator backend URL (10.0.2.2 routes to host machine):
# API_BASE_URL=https://10.0.2.2:8443/api/v1
# API_BASE_URL=http://10.0.2.2:8080/api/v1

# Default Base API URL:
API_BASE_URL=https://localhost:8443/api/v1

# Example for Ngrok tunnel:
# API_BASE_URL=https://your-custom-subdomain.ngrok-free.app/api/v1

