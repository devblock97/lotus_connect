# Lotus Connect Environment Configuration
# Copy this file to `.env` and configure your local/remote backend URL:
#   cp .env.example .env
#
# DO NOT commit `.env` to version control!

# Backend Base API URL (Local development):
API_BASE_URL=http://localhost:8080/api/v1

# Ngrok tunnel URL (Preserved for reuse across development branches):
# API_BASE_URL=https://3085-2405-4802-a3f6-2620-785a-b716-ba72-51d5.ngrok-free.app/api/v1

# Example for Android Emulator connecting to host machine localhost:
# API_BASE_URL=http://10.0.2.2:8080/api/v1
