# Lotus Connect Android Environment Example
# Copy this file to `.env.android`:
#   cp .env.android.example .env.android
#
# Android emulator routes host machine localhost via 10.0.2.2:
API_BASE_URL=https://10.0.2.2:8443/api/v1

# For direct unencrypted HTTP backend without Caddy:
# API_BASE_URL=http://10.0.2.2:8080/api/v1
